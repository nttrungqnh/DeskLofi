<Window x:Class="DeskLofi.Views.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True" Width="112" Height="106" Loaded="OnLoaded" SourceInitialized="OnSourceInitialized" MouseLeftButtonDown="OnDragStart" MouseRightButtonUp="OnRightClick" AllowDrop="True" Drop="OnFileDrop" DragOver="OnDragOver">
 <Grid>
  <Canvas x:Name="Scene" Width="112" Height="106" ClipToBounds="False">
   <Canvas x:Name="RoomDemoBack" Width="300" Height="126" Visibility="Collapsed">
    <Rectangle x:Name="RoomBase" Width="300" Height="108" Fill="#FF312D3A"/>
    <Image x:Name="BaseBackgroundLayer" Width="300" Height="108" Stretch="Fill" IsHitTestVisible="False"/>
    <Rectangle x:Name="SkyLayer" Canvas.Left="49" Canvas.Top="9" Width="40" Height="44" Fill="#FF87C5D9"/>
    <Image x:Name="SkyImageFrom" Canvas.Left="49" Canvas.Top="9" Width="40" Height="44" Stretch="Fill" Opacity="0" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
    <Image x:Name="SkyImageTo" Canvas.Left="49" Canvas.Top="9" Width="40" Height="44" Stretch="Fill" Opacity="0" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
    <Rectangle x:Name="LightingLayer" Width="300" Height="108" Fill="Transparent" IsHitTestVisible="False"/>
    <Image x:Name="LightingImageFrom" Width="300" Height="108" Stretch="Fill" Opacity="0" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
    <Image x:Name="LightingImageTo" Width="300" Height="108" Stretch="Fill" Opacity="0" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>
    <Canvas x:Name="WeatherLayer" Canvas.Left="49" Canvas.Top="9" Width="40" Height="44" ClipToBounds="True" IsHitTestVisible="False"/>
    <Rectangle x:Name="LightningLayer" Canvas.Left="49" Canvas.Top="9" Width="40" Height="44" Fill="White" Opacity="0" IsHitTestVisible="False"/>
    <Border x:Name="WindowFrame" Canvas.Left="46" Canvas.Top="6" Width="46" Height="50" BorderBrush="#FF604B4C" BorderThickness="3" Background="Transparent" IsHitTestVisible="False"/>
    <Rectangle x:Name="LampGlow" Canvas.Left="18" Canvas.Top="19" Width="20" Height="8" Fill="#FFFFD77A" Opacity="0" IsHitTestVisible="False"/>
    <TextBlock x:Name="WeatherText" Canvas.Left="246" Canvas.Top="7" Text="--" FontFamily="Consolas" FontSize="9" Foreground="#FFE8F2E8" ToolTip="Weather unavailable"/>
    <Border x:Name="ClockObject" Canvas.Left="8" Canvas.Top="5" Background="#EE172333" BorderBrush="#FF70868B" BorderThickness="1" Padding="4,2" CornerRadius="2">
      <StackPanel x:Name="ClockPanel"><TextBlock x:Name="ClockText" Text="08:30" FontFamily="Consolas" FontSize="13" FontWeight="Bold" Foreground="#FFB8E6C6"/><TextBlock x:Name="DateText" Text="24/09" FontFamily="Consolas" FontSize="8" Foreground="#FF89B4A5" HorizontalAlignment="Center"/></StackPanel>
    </Border>
    <Border Canvas.Left="3" Canvas.Top="67" Width="294" Height="45" Background="#FF25243A" CornerRadius="5" Opacity="0.96"/>
    <Rectangle Canvas.Left="0" Canvas.Top="108" Width="300" Height="8" Fill="#FF563E39"/>
    <Rectangle Canvas.Left="10" Canvas.Top="116" Width="7" Height="9" Fill="#FF312B34"/><Rectangle Canvas.Left="280" Canvas.Top="116" Width="7" Height="9" Fill="#FF312B34"/>
    <Canvas x:Name="MonitorArtwork" Width="300" Height="126" IsHitTestVisible="False">
      <Rectangle Canvas.Left="95" Canvas.Top="22" Width="112" Height="57" Fill="#FF41374B" RadiusX="3" RadiusY="3"/>
      <Rectangle Canvas.Left="100" Canvas.Top="27" Width="102" Height="46" Fill="#FF182333"/>
      <Rectangle Canvas.Left="111" Canvas.Top="35" Width="72" Height="3" Fill="#FF7FBDB0"/><Rectangle Canvas.Left="111" Canvas.Top="44" Width="50" Height="3" Fill="#FFD09B78"/><Rectangle Canvas.Left="111" Canvas.Top="53" Width="65" Height="3" Fill="#FF8C80B4"/>
    </Canvas>
   </Canvas>
    <Canvas x:Name="GirlContainer" Canvas.Left="0" Canvas.Top="0" Width="112" Height="106" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor">
      <Image x:Name="GirlSprite" Width="112" Height="106" Stretch="Uniform" UseLayoutRounding="True" SnapsToDevicePixels="True" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonUp="OnGirlClick"/>
    </Canvas>
   <Canvas x:Name="RoomDemoFront" Width="300" Height="126" Visibility="Collapsed">
    <Image x:Name="CatSprite" Canvas.Left="217" Canvas.Top="49" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor" MouseLeftButtonDown="OnCatMouseDown" MouseLeftButtonUp="OnCatClick"/>
    <Rectangle Canvas.Left="48" Canvas.Top="93" Width="20" Height="15" Fill="#FFB98653" RadiusX="2" RadiusY="2"/>
    <Rectangle Canvas.Left="52" Canvas.Top="97" Width="12" Height="7" Fill="#FF604237"/>
    <Rectangle Canvas.Left="23" Canvas.Top="25" Width="10" Height="46" Fill="#FF302C39"/><Rectangle Canvas.Left="16" Canvas.Top="23" Width="24" Height="4" Fill="#FFE1C77A"/><Rectangle Canvas.Left="21" Canvas.Top="27" Width="14" Height="5" Fill="#FFE1C77A" Opacity=".5"/>
    <Border x:Name="Radio" Canvas.Left="273" Canvas.Top="77" Width="21" Height="24" Background="#FFAF8064" CornerRadius="3" MouseLeftButtonUp="OnRadioClick" ToolTip="Music"><TextBlock Text="♫" Foreground="#FF372C3B" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <Border x:Name="DropFeedback" Canvas.Left="88" Canvas.Top="8" Background="#E8222031" Padding="6,3" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False"><TextBlock x:Name="DropFeedbackText" Foreground="White" FontSize="10"/></Border>
   </Canvas>
  </Canvas>
  <Popup x:Name="MusicPopup" Placement="Top" VerticalOffset="-8" HorizontalOffset="-108" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
   <Border Width="330" Height="418" Background="#FFF9F8FF" BorderBrush="#FFE3E0EE" BorderThickness="1" CornerRadius="14">
    <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.28" Color="#FF24223E"/></Border.Effect>
    <Border.Resources>
     <Style x:Key="MusicIconButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#FF243251"/><Setter Property="FontSize" Value="17"/><Setter Property="FontFamily" Value="Segoe UI Symbol"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
     <Style x:Key="MusicRowButton" TargetType="Button"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="5,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Stretch"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFE8EEFF"/></Trigger><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFDCEAFF"/></DataTrigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Border.Resources>
    <Grid Margin="13,11,13,8"><Grid.RowDefinitions><RowDefinition Height="75"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="55"/><ColumnDefinition Width="*"/><ColumnDefinition Width="111"/></Grid.ColumnDefinitions>
      <Border x:Name="CurrentCover" Width="50" Height="50" CornerRadius="6" Background="#FF8265AD" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True"><Grid><Ellipse Width="31" Height="31" Fill="#77FFD5A5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-7,0"/><Path Data="M 0,43 L 10,30 L 18,34 L 28,21 L 50,43 Z" Fill="#88506691" VerticalAlignment="Bottom"/><Rectangle Height="8" Fill="#66523E77" VerticalAlignment="Bottom"/></Grid></Border>
      <StackPanel Grid.Column="1" Margin="6,0,4,0"><TextBlock x:Name="TrackLabel" Text="Chưa có bài hát" Foreground="#FF253152" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="ArtistLabel" Text="Thêm nhạc để bắt đầu" Foreground="#FF8A91AA" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,1,0,5"/><Slider x:Name="ProgressSlider" Minimum="0" Maximum="1" Height="13" ValueChanged="OnProgressChanged" PreviewMouseDown="OnSeekStart" PreviewMouseUp="OnSeekEnd"/><TextBlock x:Name="ProgressLabel" Text="00:00 / 00:00" Foreground="#FF8A91AA" FontSize="9" Margin="0,1,0,0"/></StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0"><Button Content="◀▏" Width="23" Height="27" Style="{StaticResource MusicIconButton}" FontSize="12" Click="OnPrevious" ToolTip="Bài trước"/><Button x:Name="PlayButton" Content="▶" Width="29" Height="29" Background="#FF3777E6" Foreground="White" Style="{StaticResource MusicIconButton}" FontSize="13" Click="OnPlayPause" ToolTip="Phát / tạm dừng" Margin="2,0"/><Button Content="▏▶" Width="23" Height="27" Style="{StaticResource MusicIconButton}" FontSize="12" Click="OnNext" ToolTip="Bài tiếp"/><Button x:Name="PlaylistPickerButton" Content="☷" Width="27" Height="27" Style="{StaticResource MusicIconButton}" FontSize="17" Click="OnPlaylistPickerClick" ToolTip="Chọn danh sách phát"/></StackPanel>
     </Grid>
     <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock x:Name="PlaylistCaption" Text="Danh sách phát" FontSize="10" FontWeight="SemiBold" Foreground="#FF8A91AA" Margin="5,2,0,6"/>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsControl x:Name="PlaylistTracks"><ItemsControl.ItemTemplate><DataTemplate><Button Style="{StaticResource MusicRowButton}" Click="OnPlaylistTrackClick" Tag="{Binding TrackId}" ToolTip="{Binding PlayTooltip}"><Grid Height="42"><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="43"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="5" Background="{Binding CoverBrush}" HorizontalAlignment="Left" ClipToBounds="True"><Grid><Ellipse Width="22" Height="22" Fill="#66FFE0B0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-5,-5,0"/><Path Data="M 0,32 L 9,21 L 15,26 L 24,15 L 36,31 Z" Fill="#99515B87" VerticalAlignment="Bottom"/></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" Foreground="#FF263354" FontSize="11" FontWeight="Medium" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Artist}" Foreground="#FF8B93A8" FontSize="9" TextTrimming="CharacterEllipsis"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Duration}" Foreground="#FF7E89A3" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"/><TextBlock Grid.Column="3" Text="▮▮▮" Foreground="#FF3777E6" FontSize="9" VerticalAlignment="Center" HorizontalAlignment="Right"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
      <TextBlock x:Name="EmptyPlaylistHint" Grid.Row="1" Text="Danh sách này chưa có bài hát.&#10;Nhấn ⚙ để thêm nhạc." TextAlignment="Center" Foreground="#FF9AA4BA" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Center"/>
     </Grid>
     <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="☷   Mở danh sách phát" Style="{StaticResource MusicIconButton}" FontFamily="Segoe UI" FontSize="11" HorizontalAlignment="Left" Click="OnManagePlaylists" ToolTip="Tạo và quản lý danh sách phát"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="ShuffleButton" Content="⇄" Style="{StaticResource MusicIconButton}" Width="26" Click="OnShuffle" ToolTip="Phát ngẫu nhiên"/><Button x:Name="RepeatButton" Content="↻" Style="{StaticResource MusicIconButton}" Width="26" Click="OnRepeat" ToolTip="Lặp lại"/><Button x:Name="FavoriteButton" Content="♡" Style="{StaticResource MusicIconButton}" Width="26" Click="OnFavorite" ToolTip="Yêu thích"/><Button x:Name="MusicOptionsButton" Content="⚙" Style="{StaticResource MusicIconButton}" Width="27" Click="OnMusicOptionsClick" ToolTip="Tùy chọn nhạc"/></StackPanel></Grid>
    </Grid>
   </Border>
  </Popup>
 </Grid>
</Window>
