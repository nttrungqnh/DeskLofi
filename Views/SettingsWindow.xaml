<Window x:Class="DeskLofi.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskLofi - Cài đặt" Width="820" Height="740" MinWidth="720" MinHeight="620"
        WindowStartupLocation="CenterOwner" Background="#FFFCF9F7" Foreground="#FF263149" FontFamily="Segoe UI" FontSize="13">
 <Window.Resources>
  <SolidColorBrush x:Key="Accent" Color="#FF2F70E4"/>
  <SolidColorBrush x:Key="Muted" Color="#FF7D8494"/>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFE9E1DF"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Margin" Value="0,0,0,11"/>
  </Style>
  <Style x:Key="CardHeading" TargetType="Border"><Setter Property="Background" Value="#FFFFF6F2"/><Setter Property="CornerRadius" Value="13,13,0,0"/><Setter Property="Padding" Value="13,8"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="11"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="Nav" TargetType="Button">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,9"/><Setter Property="Margin" Value="9,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFE8F0FF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFDDD6D3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="13,7"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="BorderBrush" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#FF253149"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal"><Border x:Name="Square" Width="17" Height="17" CornerRadius="4" BorderBrush="#FFADB4C1" BorderThickness="1.2" Background="White" Margin="0,1,10,0"><Path x:Name="Tick" Data="M 3,8 L 7,12 L 14,4" Stroke="White" StrokeThickness="2" Visibility="Collapsed"/></Border><ContentPresenter VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Square" Property="Background" Value="{StaticResource Accent}"/><Setter TargetName="Square" Property="BorderBrush" Value="{StaticResource Accent}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8,6"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#FFDED9D8"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Padding" Value="6,5"/><Setter Property="Background" Value="White"/></Style>
  <Style TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
   <Grid Height="20" VerticalAlignment="Center"><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Orientation="Horizontal" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="{StaticResource Accent}" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
    <Track.Thumb><Thumb Width="15" Height="15"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="{StaticResource Accent}" Stroke="White" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" Background="#FFE2E5EB" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
   </Track></Grid>
  </ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>

 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#FFFFFDFC" BorderBrush="#FFF0E9E6" BorderThickness="0,0,1,0"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <StackPanel Margin="0,10,0,0">
     <Button x:Name="GeneralNav" Tag="General" Style="{StaticResource Nav}" Click="NavigateClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="⚙" FontSize="23" Foreground="{StaticResource Accent}" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Chung" FontWeight="SemiBold"/><TextBlock Text="Cài đặt cơ bản" Style="{StaticResource Hint}"/></StackPanel></Grid></Button>
     <Button x:Name="WeatherNav" Tag="Weather" Style="{StaticResource Nav}" Click="NavigateClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="☀" FontSize="23" Foreground="#FFE8A229" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Thời tiết" FontWeight="SemiBold"/><TextBlock Text="Hiển thị thời tiết" Style="{StaticResource Hint}"/></StackPanel></Grid></Button>
     <Button x:Name="MusicNav" Tag="Music" Style="{StaticResource Nav}" Click="NavigateClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="♫" FontSize="23" Foreground="#FFE25B62" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Nhạc" FontWeight="SemiBold"/><TextBlock Text="Nhạc nền và âm lượng" Style="{StaticResource Hint}"/></StackPanel></Grid></Button>
     <Button x:Name="AppearanceNav" Tag="Appearance" Style="{StaticResource Nav}" Click="NavigateClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="◉" FontSize="22" Foreground="#FFB875A0" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Giao diện" FontWeight="SemiBold"/><TextBlock Text="Nhân vật, mèo, đồng hồ" Style="{StaticResource Hint}"/></StackPanel></Grid></Button>
     <Button x:Name="OtherNav" Tag="Other" Style="{StaticResource Nav}" Click="NavigateClick"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="37"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="•••" FontSize="20" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="Khác" FontWeight="SemiBold"/><TextBlock Text="Nâng cao" Style="{StaticResource Hint}"/></StackPanel></Grid></Button>
    </StackPanel>
   </Grid></Border>

   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18,16,18,12">
     <Grid x:Name="GeneralPage"><StackPanel>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,14"><Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource Accent}" Margin="0,0,12,0"><TextBlock Text="⚙" Foreground="White" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Chung" FontSize="22" FontWeight="Bold"/><TextBlock Text="Cài đặt cơ bản cho DeskLofi" Style="{StaticResource Hint}"/></StackPanel></StackPanel>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="🌐   Ngôn ngữ" FontWeight="SemiBold"/></Border><Grid Margin="14,10,14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock Text="Ngôn ngữ giao diện" VerticalAlignment="Center"/><ComboBox x:Name="LanguageChoice" Grid.Column="1"><ComboBoxItem Content="Tiếng Việt" Tag="vi"/><ComboBoxItem Content="English" Tag="en"/></ComboBox></Grid></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="🚀   Khởi động &amp; hiển thị" FontWeight="SemiBold"/></Border><StackPanel Margin="14,8,14,10"><CheckBox x:Name="Startup" Content="Khởi động cùng Windows"/><TextBlock Text="Tự động khởi động cùng Windows" Style="{StaticResource Hint}" Margin="27,0,0,8"/><CheckBox x:Name="TopmostEnabled" Content="Luôn ở trên cùng"/><TextBlock Text="Luôn hiển thị trên cùng" Style="{StaticResource Hint}" Margin="27,0,0,8"/><CheckBox x:Name="ShowOnTaskbar" Content="Hiển thị trên thanh tác vụ"/><TextBlock Text="Đặt nhân vật trên thanh tác vụ" Style="{StaticResource Hint}" Margin="27,0,0,0"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="➤   Phản hồi hành động" FontWeight="SemiBold"/></Border><Grid Margin="14,9,12,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><CheckBox x:Name="Keyboard" Content="Phản hồi khi gõ phím"/><TextBlock Text="Nhân vật phản hồi khi bạn gõ phím" Style="{StaticResource Hint}" Margin="27,0,6,0"/></StackPanel><StackPanel Grid.Column="1"><CheckBox x:Name="Mouse" Content="Phản hồi khi dùng chuột"/><TextBlock Text="Nhân vật phản hồi khi bạn dùng chuột" Style="{StaticResource Hint}" Margin="27,0,0,0"/></StackPanel></Grid></StackPanel></Border>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Margin="0,0,5,10"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="🐱   Mèo" FontWeight="SemiBold"/></Border><StackPanel Margin="12,10,12,11"><TextBlock Text="Thời gian mèo ngủ (giây)" FontSize="12"/><Grid Margin="0,7,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Slider x:Name="Sleep" Minimum="15" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#FFF2F0EF" CornerRadius="5" Margin="5,0,0,0" Padding="4,3"><TextBlock Text="{Binding ElementName=Sleep,Path=Value,StringFormat={}{0:0}s}" HorizontalAlignment="Center"/></Border></Grid><TextBlock Text="Sau thời gian không tương tác, mèo sẽ nằm ngủ" Style="{StaticResource Hint}"/></StackPanel></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,10"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="☕   AFK" FontWeight="SemiBold"/></Border><StackPanel Margin="12,10,12,11"><TextBlock Text="Thời gian chuyển AFK (phút)" FontSize="12"/><Grid Margin="0,7,0,5"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="44"/></Grid.ColumnDefinitions><Slider x:Name="Afk" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/><Border Grid.Column="1" Background="#FFF2F0EF" CornerRadius="5" Margin="5,0,0,0" Padding="4,3"><TextBlock Text="{Binding ElementName=Afk,Path=Value,StringFormat={}{0:0}m}" HorizontalAlignment="Center"/></Border></Grid><TextBlock Text="Sau thời gian không hoạt động, nhân vật vào trạng thái AFK" Style="{StaticResource Hint}"/></StackPanel></StackPanel></Border>
      </Grid>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Border Style="{StaticResource Card}" Margin="0,0,5,0"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="▣   Hiển thị" FontWeight="SemiBold"/></Border><StackPanel Margin="12,11"><CheckBox x:Name="ShowClock" Content="Hiện đồng hồ pixel"/><TextBlock Text="Hiển thị đồng hồ pixel" Style="{StaticResource Hint}" Margin="27,0,0,9"/><CheckBox x:Name="ShowDate" Content="Hiện ngày tháng"/><TextBlock Text="Hiển thị ngày tháng" Style="{StaticResource Hint}" Margin="27,0,0,0"/></StackPanel></StackPanel></Border>
       <Border Grid.Column="1" Style="{StaticResource Card}" Margin="5,0,0,0"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="☀ ☾   Giao diện tự động" FontWeight="SemiBold"/></Border><StackPanel Margin="12,11"><CheckBox x:Name="AutoDayNight" Content="Tự động ngày/đêm"/><TextBlock Text="Tự động chuyển giao diện theo thời gian" Style="{StaticResource Hint}" Margin="27,0,0,8"/><Border CornerRadius="7" Background="#FFF9F3EF" Padding="8,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="☀  06:00  Ban ngày" FontSize="11" Foreground="#FFEAA025"/><TextBlock Grid.Column="1" Text="☾  18:00  Ban đêm" FontSize="11" Foreground="#FF7257C5"/></Grid></Border></StackPanel></StackPanel></Border>
      </Grid>
     </StackPanel></Grid>

     <Grid x:Name="WeatherPage" Visibility="Collapsed"><StackPanel><TextBlock Text="Thời tiết" FontSize="22" FontWeight="Bold"/><TextBlock Text="Điều chỉnh thời tiết và hiệu ứng trong DeskLofi" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="☀   Thời tiết thực" FontWeight="SemiBold"/></Border><StackPanel Margin="14,12"><CheckBox x:Name="EnableWeather" Content="Bật thời tiết thực (Open-Meteo)"/><TextBlock Text="Tên thành phố" Margin="0,13,0,4"/><TextBox x:Name="City"/><Grid Margin="0,11,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,6,0"><TextBlock Text="Vĩ độ" Margin="0,0,0,4"/><TextBox x:Name="Latitude"/></StackPanel><StackPanel Grid.Column="1" Margin="6,0,0,0"><TextBlock Text="Kinh độ" Margin="0,0,0,4"/><TextBox x:Name="Longitude"/></StackPanel></Grid><TextBlock Text="Chu kỳ cập nhật (phút)" Margin="0,13,0,4"/><Slider x:Name="Refresh" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"/><TextBlock x:Name="RefreshValueLabel" Style="{StaticResource Hint}"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="✦   Hiệu ứng" FontWeight="SemiBold"/></Border><StackPanel Margin="14,12"><CheckBox x:Name="WeatherEffects" Content="Hiệu ứng thời tiết" Margin="0,0,0,12"/><CheckBox x:Name="WeatherAmbience" Content="Âm thanh thời tiết tự động" Margin="0,0,0,12"/><CheckBox x:Name="Lightning" Content="Hiệu ứng chớp sáng"/><TextBlock Text="Âm lượng thời tiết" Margin="0,16,0,4"/><Slider x:Name="WeatherVolume" Minimum="0" Maximum="1" TickFrequency="0.05"/><TextBlock Text="{Binding ElementName=WeatherVolume,Path=Value,StringFormat={}{0:P0}}" Style="{StaticResource Hint}"/></StackPanel></StackPanel></Border>
     </StackPanel></Grid>

     <Grid x:Name="MusicPage" Visibility="Collapsed"><StackPanel><TextBlock Text="Nhạc" FontSize="22" FontWeight="Bold"/><TextBlock Text="Thư viện nhạc và âm lượng" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="♫   Phát nhạc" FontWeight="SemiBold"/></Border><StackPanel Margin="14,12"><CheckBox x:Name="Autoplay" Content="Tự động phát nhạc khi mở app"/><TextBlock Text="Âm lượng nhạc" Margin="0,16,0,4"/><Slider x:Name="MusicVolume" Minimum="0" Maximum="1" TickFrequency="0.05"/><TextBlock Text="{Binding ElementName=MusicVolume,Path=Value,StringFormat={}{0:P0}}" Style="{StaticResource Hint}"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="▣   Thư viện nhạc" FontWeight="SemiBold"/></Border><StackPanel Margin="14,12"><TextBlock Text="DeskLofi hỗ trợ MP3 và WAV. Tệp nhạc vẫn ở thư mục gốc của bạn." Style="{StaticResource Hint}"/><WrapPanel Margin="0,14,0,0"><Button Content="Thêm tệp" Style="{StaticResource Action}" Click="AddFilesClick" Margin="0,0,8,8"/><Button Content="Thêm thư mục" Style="{StaticResource Action}" Click="AddFolderClick" Margin="0,0,8,8"/><Button Content="Mở thư viện nhạc" Style="{StaticResource Primary}" Click="OpenLibraryClick" Margin="0,0,8,8"/></WrapPanel></StackPanel></StackPanel></Border>
     </StackPanel></Grid>

     <Grid x:Name="AppearancePage" Visibility="Collapsed"><StackPanel><TextBlock Text="Giao diện" FontSize="22" FontWeight="Bold"/><TextBlock Text="Nhân vật và khung cảnh" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="◉   Nhân vật" FontWeight="SemiBold"/></Border><StackPanel Margin="14,12"><TextBlock Text="Chọn cỡ nhân vật"/><ComboBox x:Name="CharacterSizeChoice" Margin="0,6,0,2"><ComboBoxItem Content="Nhỏ (75%)" Tag="0.75"/><ComboBoxItem Content="Vừa (100%)" Tag="1"/><ComboBoxItem Content="Lớn (125%)" Tag="1.25"/><ComboBoxItem Content="Rất lớn (150%)" Tag="1.5"/><ComboBoxItem Content="Cỡ tối đa (200%)" Tag="2"/></ComboBox><TextBlock Text="Hoặc kéo để chọn cỡ tùy chỉnh" Style="{StaticResource Hint}"/><Slider x:Name="Scale" Minimum="0.75" Maximum="2" TickFrequency="0.05" Margin="0,8,0,3"/><TextBlock x:Name="CharacterSizeLabel" Style="{StaticResource Hint}"/></StackPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="▣   Khung cảnh" FontWeight="SemiBold"/></Border><StackPanel Margin="14,12"><TextBlock Text="Chọn khung cảnh" Margin="0,0,0,6"/><ComboBox x:Name="SceneChoice"><ComboBoxItem Content="Phòng ngủ" Tag="Bedroom" IsSelected="True"/></ComboBox></StackPanel></StackPanel></Border>
     </StackPanel></Grid>

     <Grid x:Name="OtherPage" Visibility="Collapsed"><StackPanel><TextBlock Text="Khác" FontSize="22" FontWeight="Bold"/><TextBlock Text="Tùy chọn nâng cao" Style="{StaticResource Hint}" Margin="0,0,0,14"/>
      <Border Style="{StaticResource Card}"><StackPanel><Border Style="{StaticResource CardHeading}"><TextBlock Text="⚙   Chế độ nhà phát triển" FontWeight="SemiBold"/></Border><StackPanel Margin="14,12"><CheckBox x:Name="DebugMode" Content="Mô phỏng thời gian và thời tiết"/><TextBlock Text="Thời gian mô phỏng" Margin="0,15,0,5"/><ComboBox x:Name="DebugTimeChoice"><ComboBoxItem Content="Buổi sáng" Tag="Morning"/><ComboBoxItem Content="Ban ngày" Tag="Day"/><ComboBoxItem Content="Buổi tối" Tag="Evening"/><ComboBoxItem Content="Ban đêm" Tag="Night"/></ComboBox><TextBlock Text="Thời tiết mô phỏng" Margin="0,15,0,5"/><ComboBox x:Name="DebugWeatherChoice"><ComboBoxItem Content="Quang đãng" Tag="Clear"/><ComboBoxItem Content="Nhiều mây" Tag="Cloudy"/><ComboBoxItem Content="Mưa" Tag="Rain"/><ComboBoxItem Content="Mưa lớn" Tag="HeavyRain"/><ComboBoxItem Content="Dông" Tag="Thunderstorm"/><ComboBoxItem Content="Sương mù" Tag="Fog"/><ComboBoxItem Content="Tuyết" Tag="Snow"/><ComboBoxItem Content="Mưa phùn" Tag="Drizzle"/><ComboBoxItem Content="Ít mây" Tag="PartlyCloudy"/></ComboBox></StackPanel></StackPanel></Border>
     </StackPanel></Grid>
    </Grid>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="1" Background="#FFFFFCFA" BorderBrush="#FFE9E1DF" BorderThickness="0,1,0,0"><Grid Margin="12,8"><Button Content="↻  Khôi phục mặc định" Style="{StaticResource Action}" HorizontalAlignment="Left" Click="ResetClick"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Hủy" Style="{StaticResource Action}" Width="76" Margin="0,0,8,0" Click="CancelClick"/><Button Content="▣  Lưu cài đặt" Style="{StaticResource Primary}" Width="130" Click="SaveClick"/></StackPanel></Grid></Border>
 </Grid>
</Window>
