<Window x:Class="DeskLofi.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DeskLofi Settings" Width="410" Height="540" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FF252332" Foreground="White">
 <DockPanel Margin="14">
  <TextBlock DockPanel.Dock="Top" Text="DeskLofi Settings" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,10"/>
  <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0"><Button Content="Save" Padding="20,7" Click="SaveClick"/><Button Content="Cancel" Padding="15,7" Margin="8,0,0,0" Click="CancelClick"/></StackPanel>
  <TabControl>
   <TabItem Header="General"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <CheckBox x:Name="Startup" Content="Start with Windows" Margin="0,5"/><CheckBox x:Name="TopmostEnabled" Content="Always on top" Margin="0,5"/><CheckBox x:Name="Keyboard" Content="React to keyboard" Margin="0,5"/><CheckBox x:Name="Mouse" Content="React to mouse" Margin="0,5"/><CheckBox x:Name="Autoplay" Content="Auto play music" Margin="0,5"/>
    <TextBlock Text="Cat sleep timeout (seconds)" Margin="0,10,0,3"/><Slider x:Name="Sleep" Minimum="15" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"/><TextBlock Text="AFK timeout (minutes)" Margin="0,8,0,3"/><Slider x:Name="Afk" Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True"/>
    <CheckBox x:Name="ShowClock" Content="Show pixel clock" Margin="0,8,0,3"/><CheckBox x:Name="ShowDate" Content="Show date" Margin="0,4"/><CheckBox x:Name="AutoDayNight" Content="Automatic day/night" Margin="0,4"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Weather"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12">
    <CheckBox x:Name="EnableWeather" Content="Enable real weather (Open-Meteo)" Margin="0,5"/>
    <TextBlock Text="City name (display only)" Margin="0,8,0,3"/><TextBox x:Name="City" Padding="4"/>
    <TextBlock Text="Latitude" Margin="0,8,0,3"/><TextBox x:Name="Latitude" Padding="4"/>
    <TextBlock Text="Longitude" Margin="0,8,0,3"/><TextBox x:Name="Longitude" Padding="4"/>
    <TextBlock Text="Refresh interval (minutes)" Margin="0,8,0,3"/><Slider x:Name="Refresh" Minimum="5" Maximum="120" TickFrequency="5" IsSnapToTickEnabled="True"/>
    <CheckBox x:Name="WeatherEffects" Content="Weather visuals" Margin="0,5"/><CheckBox x:Name="WeatherAmbience" Content="Weather ambience (Auto)" Margin="0,5"/><CheckBox x:Name="Lightning" Content="Enable lightning flashes" Margin="0,5"/>
    <TextBlock Text="Weather ambience volume" Margin="0,8,0,3"/><Slider x:Name="WeatherVolume" Minimum="0" Maximum="1" TickFrequency="0.05"/>
    <Separator Margin="0,10"/><CheckBox x:Name="DebugMode" Content="Developer mode: simulate time/weather" Margin="0,5"/><TextBlock Text="Debug time" Margin="0,5,0,2"/><ComboBox x:Name="DebugTimeChoice"><ComboBoxItem Content="Morning"/><ComboBoxItem Content="Day"/><ComboBoxItem Content="Evening"/><ComboBoxItem Content="Night"/></ComboBox><TextBlock Text="Debug weather" Margin="0,7,0,2"/><ComboBox x:Name="DebugWeatherChoice"><ComboBoxItem Content="Clear"/><ComboBoxItem Content="Cloudy"/><ComboBoxItem Content="Rain"/><ComboBoxItem Content="HeavyRain"/><ComboBoxItem Content="Thunderstorm"/><ComboBoxItem Content="Fog"/><ComboBoxItem Content="Snow"/><ComboBoxItem Content="Drizzle"/><ComboBoxItem Content="PartlyCloudy"/></ComboBox>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Music"><StackPanel Margin="12"><TextBlock Text="Local library supports MP3 and WAV. Audio files stay in their original folders." TextWrapping="Wrap"/><TextBlock Text="Add files, folders, manage playlists, and remove missing tracks from the radio popup." TextWrapping="Wrap" Margin="0,8"/><StackPanel Orientation="Horizontal" Margin="0,8"><Button Content="Add Files" Click="AddFilesClick" Margin="2" Padding="7,4"/><Button Content="Add Folder" Click="AddFolderClick" Margin="2" Padding="7,4"/><Button Content="Open Music Library" Click="OpenLibraryClick" Margin="2" Padding="7,4"/></StackPanel><TextBlock Text="Music volume" Margin="0,8,0,3"/><Slider x:Name="MusicVolume" Minimum="0" Maximum="1" TickFrequency="0.05"/></StackPanel></TabItem>
   <TabItem Header="Appearance"><StackPanel Margin="12"><TextBlock Text="Companion scale" Margin="0,5,0,3"/><Slider x:Name="Scale" Minimum="0.75" Maximum="1.5" TickFrequency="0.05"/><TextBlock Text="Scene" Margin="0,8,0,3"/><ComboBox x:Name="SceneChoice"><ComboBoxItem Content="Bedroom" IsSelected="True"/></ComboBox></StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
