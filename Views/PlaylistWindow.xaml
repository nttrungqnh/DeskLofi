<Window x:Class="DeskLofi.Views.PlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskLofi - Danh sách phát" Width="370" Height="470" MinWidth="340" MinHeight="400"
        WindowStartupLocation="CenterOwner" Background="#FFF9F8FF" Foreground="#FF263354" FontFamily="Segoe UI" FontSize="12">
 <Window.Resources>
  <Style x:Key="ActionButton" TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="13,8"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="BorderBrush" Value="#FFDCE1EF"/><Setter Property="Background" Value="White"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}"><Setter Property="Background" Value="#FF3777E6"/><Setter Property="BorderBrush" Value="#FF3777E6"/><Setter Property="Foreground" Value="White"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="8,5"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFE9F0FF"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#FFDCEAFF"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="18,17,18,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,15"><TextBlock Text="Danh sách phát" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Chọn, tạo và sắp xếp nhạc theo tâm trạng" FontSize="11" Foreground="#FF8892A9" Margin="0,3,0,0"/></StackPanel>
  <Border Grid.Row="1" Background="White" BorderBrush="#FFE3E6F0" BorderThickness="1" CornerRadius="12" Padding="9"><ListBox x:Name="Items" Background="Transparent" BorderThickness="0" SelectionChanged="SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"><ListBox.ItemTemplate><DataTemplate><Grid Height="42"><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="34" Height="34" CornerRadius="6" Background="#FFDBE6FF" HorizontalAlignment="Left"><TextBlock Text="♫" Foreground="#FF3777E6" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Grid.Column="1" Text="{Binding}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="›" FontSize="18" Foreground="#FF9BA7BC" VerticalAlignment="Center" Margin="0,0,5,0"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border>
  <StackPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock Text="Tên danh sách phát" Foreground="#FF6D7891" FontSize="11" Margin="0,0,0,5"/><TextBox x:Name="NameInput" Background="White" BorderBrush="#FFDCE1EF" BorderThickness="1" Padding="9,8" FontSize="12"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="+  Tạo mới" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CreateClick"/><Button Grid.Column="1" Content="Đổi tên" Style="{StaticResource ActionButton}" Click="RenameClick" Margin="0,0,8,0"/><Button Grid.Column="2" Content="Xóa" Style="{StaticResource ActionButton}" Foreground="#FFBE5268" Click="DeleteClick"/></Grid></StackPanel>
 </Grid>
</Window>
