<Window x:Class="DeskLofi.Views.PlaylistWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Music Playlists" Width="300" Height="340" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#FF252332" Foreground="White">
 <Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="Playlists" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
  <ListBox x:Name="Items" Grid.Row="1" SelectionChanged="SelectionChanged"/>
  <TextBox x:Name="NameInput" Grid.Row="2" Margin="0,8" Padding="5"/>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Create" Click="CreateClick" Margin="3" Padding="8,4"/><Button Content="Rename" Click="RenameClick" Margin="3" Padding="8,4"/><Button Content="Delete" Click="DeleteClick" Margin="3" Padding="8,4"/></StackPanel>
 </Grid>
</Window>
